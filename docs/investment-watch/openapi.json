{
  "openapi": "3.1.0",
  "info": {
    "title": "投资动态可用版接口",
    "version": "0.4.0",
    "description": "Django session + CSRF. Public news is family-scoped; dossiers, candidates, reviews and notes are owner-scoped with no admin bypass. GET does not collect or call models. Cursors expire after 24h and bind to member, route and filters; live results are not frozen snapshots."
  },
  "security": [
    {
      "Session": []
    }
  ],
